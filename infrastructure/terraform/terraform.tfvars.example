project_id = "staffalias-prod"
region     = "asia-southeast1"

artifact_registry_repository = "staffalias"
cloud_run_service_name       = "staffalias-api"

# The default public Cloud Run hello image is only a bootstrap placeholder.
# Issue #31 will deploy the real StaffAlias backend image from Artifact Registry.
# cloud_run_image = "asia-southeast1-docker.pkg.dev/staffalias-prod/staffalias/backend:<commit-sha>"

cloud_run_min_instances = 0
cloud_run_max_instances = 3
cloud_run_cpu           = "1"
cloud_run_memory        = "512Mi"
allow_unauthenticated   = true
