project_id = "staffalias-prod"
region     = "asia-southeast1"

artifact_registry_repository = "staffalias"
cloud_run_service_name       = "staffalias-api"

# Optional bootstrap image used only when Terraform first creates the Cloud Run service.
# After the first GitHub backend deployment, Terraform intentionally ignores changes to
# the deployed image and application env/secret bindings so it will not roll releases back.
# cloud_run_image = "us-docker.pkg.dev/cloudrun/container/hello"

cloud_run_min_instances = 0
cloud_run_max_instances = 3
cloud_run_cpu           = "1"
cloud_run_memory        = "512Mi"
allow_unauthenticated   = true
