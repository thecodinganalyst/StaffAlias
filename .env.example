# StaffAlias local development environment
# Copy this file to .env for local development.
# Never commit real credentials.

STAFFALIAS_PROFILE=dev

# Backend
STAFFALIAS_BACKEND_PORT=8080

# Initial platform administrator bootstrap.
# Configure both values together. After the account exists, restarts do not reset its password.
# Store production values in the deployment secret store, not in source control.
PLATFORM_ADMIN_USERNAME=
PLATFORM_ADMIN_PASSWORD=

# Frontend
STAFFALIAS_FRONTEND_PORT=5173
STAFFALIAS_API_BASE_URL=http://localhost:8080

# PostgreSQL local development container
STAFFALIAS_DB_HOST=localhost
STAFFALIAS_DB_PORT=5432
STAFFALIAS_DB_NAME=staffalias
STAFFALIAS_DB_USER=staffalias
STAFFALIAS_DB_PASSWORD=staffalias

# Spring Boot datasource overrides (optional for dev; required in prod).
# For Supabase production use the supplied PostgreSQL/pooler endpoint and require SSL.
# Example shape only — never commit real production credentials:
# DB_URL=jdbc:postgresql://<supabase-pooler-host>:<port>/<database>?sslmode=require
# DB_USERNAME=<supabase-database-user>
# DB_PASSWORD=<supabase-database-password>
#
# Optional production Hikari pool tuning. Defaults are intentionally conservative for Cloud Run.
# DB_POOL_MAX_SIZE=5
# DB_POOL_MIN_IDLE=0
# DB_CONNECTION_TIMEOUT_MS=10000
# DB_VALIDATION_TIMEOUT_MS=5000
# DB_IDLE_TIMEOUT_MS=600000
# DB_MAX_LIFETIME_MS=1800000
# DB_KEEPALIVE_TIME_MS=0

# Optional transactional email. StaffAlias starts normally when these are blank.
RESEND_API_KEY=
RESEND_FROM=
STAFFALIAS_FRONTEND_URL=http://localhost:5173
